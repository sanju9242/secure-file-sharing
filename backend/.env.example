PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FILE_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
MAX_FILE_SIZE_MB=25
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=replace_with_server_only_secret_key

# Generate the encryption key on Windows PowerShell:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" # FILE_ENCRYPTION_KEY
# Copy this file to backend/.env and replace the placeholder values.
